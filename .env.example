# Copy to .env and supply real values. Never commit .env.
OPENAI_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
# Separate multiple recipients with commas.
EMAIL_TO=first@example.com,second@example.com

# Adzuna personal-research API
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
REED_API_KEY=

# Local Docker defaults
DATABASE_URL=postgresql://job_agent:job_agent@db:5432/job_agent
POSTGRES_DB=job_agent
POSTGRES_USER=job_agent
POSTGRES_PASSWORD=job_agent
POSTGRES_PORT=5434
WEB_PORT=8000

# Agent behaviour
TIMEZONE=Europe/London
SEARCH_HOURS=8,18
RUN_ON_STARTUP=false
OPENAI_SEARCH_MODEL=gpt-5.6-luna
OPENAI_REVIEW_MODEL=gpt-5.6-terra
OPENAI_TAILOR_MODEL=gpt-5.6-terra
MAX_DISCOVERED_JOBS=60
ADZUNA_RESULTS_PER_QUERY=10
ADZUNA_MAX_CANDIDATES=40
REED_RESULTS_PER_QUERY=10
REED_MAX_CANDIDATES=40
POSSIBLE_EMAIL_LIMIT=15
MIN_FIT_SCORE=65
SPONSOR_MATCH_THRESHOLD=92
DRY_RUN_EMAIL=false
